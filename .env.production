# Production Environment Configuration
# Copy this file to .env on the production server and fill in the values

# APP configuration
HOST=0.0.0.0
PORT=3000

# Database configuration
DB_PORT=5432
DB_NAME=tiendatap
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT configuration
JWT_SECRET=CHANGE_ME_STRONG_SECRET_KEY
NEXTAUTH_SECRET=CHANGE_ME_STRONG_SECRET_KEY
NEXTAUTH_URL=https://tiendatap.com

# Upload configuration
UPLOAD_PATH=/uploads

# General WhatsApp contact for homepage
CONTACT_WHATSAPP=+520000000000
