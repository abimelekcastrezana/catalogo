# Copia este archivo a .env (cp .env.dev.example .env). El archivo .env NUNCA se sube a git.
# Solo valores de desarrollo local: no son secretos reales.

# Servidor
HOST=localhost
PORT=3000

# Base de datos (la levanta `npm run db:up`)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiendatap_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Autenticación
JWT_SECRET=dev_solo_para_local_cambia_esto
NEXTAUTH_URL=http://localhost:3000

# Imágenes subidas (obligatorio: sin esto la app no arranca)
UPLOAD_PATH=./uploads

# Teléfono de contacto de la home (opcional)
CONTACT_WHATSAPP=+520000000000
