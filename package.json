  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sequelize": "^6.37.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.6"
  }
}
