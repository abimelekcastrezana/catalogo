{
  "name": "catalogo-de-produtos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrations:run": "npx sequelize-cli db:migrate --config db/config.js",
